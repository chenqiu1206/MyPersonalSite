# ---- 依赖 ----
# npm install 生成：65.5 MB / 1241 个文件，含 Windows 专用二进制。
# 任何人可凭 package.json + package-lock.json 装回一模一样的内容，不需要上传。
node_modules/

# ---- 构建产物 ----
# npm run build 生成，文件名带内容哈希，每构建一次就换一套名字。
# 提交它等于每次构建都往仓库塞一份废弃文件。
dist/
dist-ssr/

# ---- 本地环境变量 ----
# 可能含密钥与个人配置，不要提交；需要共享的模板请另存为 .env.example
*.local
.env
.env.*
!.env.example

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 编辑器与系统文件 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 工具缓存 ----
.vite/
